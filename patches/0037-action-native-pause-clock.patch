 // XBE_GLOBAL(0x002adf48, 0x8)
 double INITIALISATION_TIME;

+// Only the game clock excludes native app holds. The host timestamp remains
+// free-running for file/stream timeouts; movies own their separate pause clock.
+static std::mutex nativeGameClockMutex;
+static double nativeGameClockHeldAt = -1.0;
+static double nativeGameClockHeldMs = 0.0;
+
+void Game_SetNativeClockPaused(bool paused) {
+  std::lock_guard<std::mutex> lock(nativeGameClockMutex);
+  if (Demo_Active())
+    return; // Recorded time already stops with the replay's frame counter.
+  if (paused && nativeGameClockHeldAt < 0.0)
+    nativeGameClockHeldAt = timestamp();
+  else if (!paused && nativeGameClockHeldAt >= 0.0) {
+    nativeGameClockHeldMs += timestamp() - nativeGameClockHeldAt;
+    nativeGameClockHeldAt = -1.0;
+  }
+}
+
 // AUTOINJECT
 void psiInitTimeIn100ths(void) {
+  std::lock_guard<std::mutex> lock(nativeGameClockMutex);
   INITIALISATION_TIME = timestamp();
+  nativeGameClockHeldAt = -1.0;
+  nativeGameClockHeldMs = 0.0;
 }

 // AUTOINJECT
 ulonglong psiGetTimeIn100ths(void) {
-  return (ulonglong)Ftol64((Extended(timestamp()) - Extended(INITIALISATION_TIME)) * Extended(0.1));
+  std::lock_guard<std::mutex> lock(nativeGameClockMutex);
+  double now = timestamp();
+  if (!Demo_Active()) {
+    if (nativeGameClockHeldAt >= 0.0)
+      now = nativeGameClockHeldAt;
+    now -= nativeGameClockHeldMs;
+  }
+  return (ulonglong)Ftol64((Extended(now) - Extended(INITIALISATION_TIME)) * Extended(0.1));
 }

