diff --git a/src/action/sound/SFX.cpp b/src/action/sound/SFX.cpp
index 45b0aa7..da17bd3 100644
--- a/src/action/sound/SFX.cpp
+++ b/src/action/sound/SFX.cpp
@@ -1288,6 +1288,26 @@ void SFXUnloadSoundBank(int index) {
     bank->Loaded = 0;
 }
 
+// NightPad: another launch follows this session in the same process. The banks' sample memory and a stream's
+// file memory live in the game heap, which the next session replaces; unload them while it is still valid,
+// or the next session's SFXReset frees those pointers and faults in Mem_Free. Unlike SFXReset this leaves
+// the audio stream system and the mixer alone.
+void SFXShutdown(void) {
+    SFXItem *next;
+    for (SFXItem *Sfx = BaseSFXActive; Sfx != NULL; Sfx = next) {
+        next = Sfx->Next;
+        KillSFX(Sfx);
+    }
+    for (int slot = 0; slot < SFX_NUM_BANKS; slot++) {
+        if (SoundBankData[slot].Loaded)
+            SFXUnloadSoundBank(SoundBankData[slot].HashCode);
+    }
+    StreamData *stream = &Streams[0];
+    if (StreamIsActive(stream))
+        SFXStopStream(stream);
+    stream->Status = STREAM_FREE;
+}
+
 // Stops every sound and the stream, frees the banks, and puts the mixer back as it starts
 // AUTOINJECT
 void SFXReset(void) {
