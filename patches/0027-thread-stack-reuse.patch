+struct CachedWindowStack {
+    void *block;
+    size_t size;
+};
+
+static std::vector<CachedWindowStack> g_cachedWindowStacks;
+static pthread_mutex_t g_cachedWindowStacksMutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void *TakeWindowStack(size_t *size) {
+    pthread_mutex_lock(&g_cachedWindowStacksMutex);
+    void *block = NULL;
+    for (size_t i = 0; i < g_cachedWindowStacks.size(); ++i) {
+        if (g_cachedWindowStacks[i].size < *size)
+            continue;
+        block = g_cachedWindowStacks[i].block;
+        *size = g_cachedWindowStacks[i].size;
+        g_cachedWindowStacks.erase(g_cachedWindowStacks.begin() + i);
+        break;
+    }
+    pthread_mutex_unlock(&g_cachedWindowStacksMutex);
+    return block;
+}
+
+static void ReturnWindowStack(void *block, size_t size) {
+    if (block == NULL)
+        return;
+    pthread_mutex_lock(&g_cachedWindowStacksMutex);
+    g_cachedWindowStacks.push_back({block, size});
+    pthread_mutex_unlock(&g_cachedWindowStacksMutex);
+}
+
 static long Release(Thread *thread) {
     long left = __atomic_sub_fetch(&thread->references, 1, __ATOMIC_ACQ_REL);
