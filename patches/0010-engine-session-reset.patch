+// Release what the previous game session loaded into the persistent device. The ring, transfer buffers, black
+// textures and back buffer are device-scoped and stay; the game's textures, shaders, samplers and pipelines are not.
+void D3D9_ResetSessionCache() {
+    if (g_device == NULL)
+        return;
+    for (int i = 0; i < g_textureCount; i++)
+        if (g_textures[i].texture != NULL)
+            SDL_ReleaseGPUTexture(g_device, g_textures[i].texture);
+    memset(g_textures, 0, sizeof(g_textures));
+    g_textureCount = 0;
+    for (int i = 0; i < g_pixelShaderCount; i++)
+        if (g_pixelShaders[i].shader != NULL)
+            SDL_ReleaseGPUShader(g_device, g_pixelShaders[i].shader);
+    g_pixelShaderCount = 0;
+    g_currentPixelShader = -1;
+    for (int i = 0; i < g_vertexShaderCount; i++) {
+        if (g_vertexShaders[i].shader != NULL)
+            SDL_ReleaseGPUShader(g_device, g_vertexShaders[i].shader);
+        if (g_vertexShaders[i].spriteShader != NULL)
+            SDL_ReleaseGPUShader(g_device, g_vertexShaders[i].spriteShader);
+    }
+    g_vertexShaderCount = 0;
+    g_currentVertexShader = -1;
+    for (std::map<std::string, SDL_GPUGraphicsPipeline *>::iterator it = g_pipelines.begin();
+         it != g_pipelines.end(); ++it)
+        SDL_ReleaseGPUGraphicsPipeline(g_device, it->second);
+    g_pipelines.clear();
+    for (std::map<std::string, SDL_GPUShader *>::iterator it = g_fixedPrograms.begin(); it != g_fixedPrograms.end(); ++it)
+        SDL_ReleaseGPUShader(g_device, it->second);
+    g_fixedPrograms.clear();
+    g_fixedProgramSamplers.clear();
+    for (std::map<std::string, SDL_GPUSampler *>::iterator it = g_samplers.begin(); it != g_samplers.end(); ++it)
+        SDL_ReleaseGPUSampler(g_device, it->second);
+    g_samplers.clear();
+    // g_backBuffer.depth is an entry of g_depthTextures: keep that cache, or the persistent back buffer dangles.
+    if (g_readBackScaled != NULL) SDL_ReleaseGPUTexture(g_device, g_readBackScaled);
+    if (g_visibilityMask != NULL) SDL_ReleaseGPUTexture(g_device, g_visibilityMask);
+    if (g_movieTexture != NULL) SDL_ReleaseGPUTexture(g_device, g_movieTexture);
+    if (g_fxaaCopy != NULL) SDL_ReleaseGPUTexture(g_device, g_fxaaCopy);
+    if (g_fxaaVertexShader != NULL) SDL_ReleaseGPUShader(g_device, g_fxaaVertexShader);
+    if (g_fxaaPixelShader != NULL) SDL_ReleaseGPUShader(g_device, g_fxaaPixelShader);
+    if (g_pretransformedShader != NULL) SDL_ReleaseGPUShader(g_device, g_pretransformedShader);
+    g_readBackScaled = g_visibilityMask = g_movieTexture = g_fxaaCopy = NULL;
+    g_fxaaVertexShader = g_fxaaPixelShader = g_pretransformedShader = NULL;
+    g_movieWidth = g_movieHeight = g_movieBatch = 0;
+    if (g_frameFence != NULL)
+        SDL_ReleaseGPUFence(g_device, g_frameFence);
+    g_frameFence = NULL;
+    g_releaseAfterFlush.clear();
+    g_textureUploads.clear();
+    g_commands.clear();
+    g_passes.clear();
+    g_draws.clear();
+    g_blits.clear();
+    g_downloads.clear();
+    g_vertexUniformSnapshots.clear();
+    g_pixelUniformSnapshots.clear();
+    g_passOpen = false;
+    g_passColour = g_passDepth = NULL;
+    g_currentTarget = g_backBuffer;
+}
