+// Host-only: the original process exited with its workers and slots. A launch in this process has to stop them
+// while their block is still mapped, because the game heap that holds it is freed next.
+void FILESYS_shutdown() {
+    if (FsWorkers != NULL) {
+        WorkerExit = 1;
+        for (int i = 0; i < 2; i++) {
+            FsWorker *w = &FsWorkers[i];
+            if (!w->alive)
+                continue;
+            SIGNAL_post(&w->signal);
+            Xbox_WaitForSingleObject(w->thread.handle, INFINITE);
+            THREAD_destroy(&w->thread);
+            SIGNAL_destroy(&w->signal);
+            Xbox_CloseHandle(w->doneEvent);
+            REALMUTEX_destroy(&w->atomicMutex);
+            w->alive = 0;
+        }
+    }
+    if (Slots != NULL) {
+        for (int i = 0; i < SlotCount; i++) {
+            HANDLE handle = Slots[i].handle;
+            if (handle == NULL || handle == (HANDLE)1)
+                continue;
+            bool shared = false;   // an archive and its subfiles hold the same handle
+            for (int earlier = 0; earlier < i && !shared; earlier++)
+                shared = Slots[earlier].handle == handle;
+            if (!shared)
+                Xbox_CloseHandle(handle);
+        }
+        Slots = NULL;
+        SlotCount = 0;
+    }
+    FsWorkers = NULL;
+    OpRecords = NULL;
+    NextBigId = -1;
+    WorkerExit = 0;
 }
 
