+void HostInput_SetHostPadsEnabled(bool enabled) {
+    HostEnterLock(PortsLock());
+    memset(HostPads, 0, sizeof(HostPads));
+    memset(HostPadPresent, 0, sizeof(HostPadPresent));
+    HostPadsEnabled.store(enabled, std::memory_order_release);
+    HostLeaveLock(PortsLock());
+}
+
+void HostInput_SetHostPad(int port, const HostPadState *state) {
+    if (port < 0 || port >= kPorts)
+        return;
+    HostEnterLock(PortsLock());
+    HostPadPresent[port] = state != NULL;
+    if (state != NULL) {
+        HostPads[port] = *state;
+        HostPads[port].packetNumber = 0;
+    } else {
+        memset(&HostPads[port], 0, sizeof(HostPads[port]));
+    }
+    HostLeaveLock(PortsLock());
+}
+
+void HostInput_SetRumbleHandler(HostRumbleHandler handler) {
+    HostRumble.store(handler, std::memory_order_release);
+}
