+// NightPad's two optional assists, owned by the app. Bit 0 is immortality and
+// bit 1 is unlimited ammo; the runtime sets them. Applying them here means a
+// codename load cannot silently turn an assist off.
+extern "C" unsigned NightPadActionAssistFlags = 0;
+static unsigned g_appliedAssists = 0;
+
+static void ApplyAssists(void) {
+    const unsigned wanted = NightPadActionAssistFlags;
+    if (wanted & 1u)
+        CheatInfo.Immortal = 1;
+    if (wanted & 2u)
+        CheatInfo.UnlimitedAmmo = 1;
+    if (wanted != g_appliedAssists) {
+        if ((wanted & 1u) == 0)
+            CheatInfo.Immortal = 0;
+        if ((wanted & 2u) == 0)
+            CheatInfo.UnlimitedAmmo = 0;
+        g_appliedAssists = wanted;
+    }
+}
+
 extern "C" unsigned long NightPadActionEngineFrameCount(void) {
     return g_mainloopFrames.load(std::memory_order_acquire);
 }
