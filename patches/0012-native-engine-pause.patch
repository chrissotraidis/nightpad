+// A native app pause, separate from the game's own Xbox Start pause. The loop keeps its thread and resources alive,
+// but stops advancing frames until ResumePause.
+inline std::atomic<bool> &EngineLifecycle_PauseFlag() {
+    static std::atomic<bool> paused{false};
+    return paused;
+}
+
+inline bool EngineLifecycle_PauseRequested() {
+    return EngineLifecycle_PauseFlag().load(std::memory_order_acquire);
+}
+
+inline void EngineLifecycle_RequestPause() {
+    EngineLifecycle_PauseFlag().store(true, std::memory_order_release);
+}
+
+inline void EngineLifecycle_ReleasePause() {
+    EngineLifecycle_PauseFlag().store(false, std::memory_order_release);
+}
+
 #endif // COMMON_ENGINE_LIFECYCLE_H_
 
