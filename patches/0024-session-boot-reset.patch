diff --git a/src/action/game.cpp b/src/action/game.cpp
index ae86a8f..8d1f6d2 100644
--- a/src/action/game.cpp
+++ b/src/action/game.cpp
@@ -1087,6 +1087,14 @@ void GameFlow_QuickPushState(uint state) {
     set_InhibitGameDrawIfRequired();
 }
 
+// NightPad: a launch in this process is a fresh game boot. The flow stack is a process static, so without this a
+// second session continued from the previous one's top state (GAMEFLOW_GAME), skipped GAMEFLOW_BOOT, never
+// initialised the front end, and drew an empty black screen while frames advanced.
+void GameFlow_ResetForBoot(void) {
+    StackIndex = 1;
+    GameStateStack[0] = GAMEFLOW_BOOT;
+}
+
