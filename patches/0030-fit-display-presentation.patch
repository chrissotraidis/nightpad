diff --git a/src/common/gfx/presentationRect.h b/src/common/gfx/presentationRect.h
new file mode 100644
index 0000000..c6f3b0c
--- /dev/null
+++ b/src/common/gfx/presentationRect.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <stdint.h>
+
+// Presentation is independent of the render target: Xbox widescreen can be
+// anamorphic, and RenderWidth/RenderHeight only control rendering resolution.
+struct PresentationRect { uint32_t x, y, w, h; };
+
+static inline PresentationRect PresentationSafeArea(uint32_t pixelWidth, uint32_t pixelHeight,
+                                                     int windowWidth, int windowHeight,
+                                                     int x, int y, int w, int h) {
+    PresentationRect full = { 0, 0, pixelWidth, pixelHeight };
+    if (windowWidth <= 0 || windowHeight <= 0 || x < 0 || y < 0 || w <= 0 || h <= 0 ||
+        (int64_t)x + w > windowWidth || (int64_t)y + h > windowHeight)
+        return full;
+    // Round inward so no important pixels land under the cutout/home indicator.
+    uint32_t left = ((uint64_t)x * pixelWidth + windowWidth - 1) / windowWidth;
+    uint32_t top = ((uint64_t)y * pixelHeight + windowHeight - 1) / windowHeight;
+    uint32_t right = (uint64_t)(x + w) * pixelWidth / windowWidth;
+    uint32_t bottom = (uint64_t)(y + h) * pixelHeight / windowHeight;
+    return { left, top, right > left ? right - left : 0, bottom > top ? bottom - top : 0 };
+}
+
+static inline PresentationRect PresentationFit(PresentationRect area, bool widescreen) {
+    if (area.w == 0 || area.h == 0)
+        return { area.x, area.y, 0, 0 };
+    uint32_t numerator = widescreen ? 16 : 4, denominator = widescreen ? 9 : 3;
+    uint32_t width = area.w, height = area.h;
+    if ((uint64_t)width * denominator > (uint64_t)height * numerator)
+        width = (uint64_t)height * numerator / denominator;
+    else
+        height = (uint64_t)width * denominator / numerator;
+    // Tiny/minimized drawables cannot contain even one pixel of this aspect.
+    if (width == 0 || height == 0)
+        return { area.x, area.y, 0, 0 };
+    return { area.x + (area.w - width) / 2, area.y + (area.h - height) / 2, width, height };
+}
