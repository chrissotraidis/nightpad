 void D3D9_ResetSessionCache(void);
+// Releases a claimed window from the GPU device before the window is destroyed.
+void D3D9_ReleaseGpuWindow(void *window);
 
 // Visibility tests: the NV2A counts the pixels that pass the depth test between Begin and End(index), and the
 // game asks for the count later. Occlusion queries, one per index. GetResult returns 0 with the count when it
diff --git a/src/common/gfx/sdlGpuBackend.cpp b/src/common/gfx/sdlGpuBackend.cpp
index 8c088bd..4b4cb04 100644
--- a/src/common/gfx/sdlGpuBackend.cpp
+++ b/src/common/gfx/sdlGpuBackend.cpp
@@ -3003,3 +3003,14 @@ void D3D9_ResetSessionCache() {
     g_passColour = g_passDepth = NULL;
     g_currentTarget = g_backBuffer;
 }
+
+// A window is about to be destroyed. SDL's GPU device keeps per-window data for every window it has claimed;
+// releasing it first is the documented order, and leaving it behind lets a later window inherit stale
+// bookkeeping (a window created with no Metal view while the engine still presents into the device).
+void D3D9_ReleaseGpuWindow(void *window) {
+    if (g_device == NULL || g_window == NULL || (void *)g_window != window) {
+        return;
+    }
+    SDL_ReleaseWindowFromGPUDevice(g_device, g_window);
+    g_window = NULL;
+}
