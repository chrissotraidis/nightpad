     BIN_PullBits_U8(block, &cursor, &input->inverted, 1);
     BIN_PullBits_U16(block, &cursor, (ushort *)&input->controlStyle, 4);
     BIN_PullBits_U16(block, &cursor, (ushort *)&input->controlStyleDriving, 4);
+#ifdef __APPLE__
+    // NightPad: codenames made before Nightfire became the default carry the old
+    // default, Classic Bond (7). Move one such codename to Nightfire (0), once per
+    // install; a scheme chosen afterwards is kept.
+    if (input->controlStyle == 7) {
+        CFStringRef key = CFSTR("NightPadNightfireUpgradeDone");
+        Boolean found = false;
+        if (!CFPreferencesGetAppBooleanValue(key, kCFPreferencesCurrentApplication, &found) || !found) {
+            input->controlStyle = 0;
+            CFPreferencesSetAppValue(key, kCFBooleanTrue, kCFPreferencesCurrentApplication);
+            CFPreferencesAppSynchronize(kCFPreferencesCurrentApplication);
+        }
+    }
+#endif
