diff --git a/src/common/engineLifecycle.h b/src/common/engineLifecycle.h
new file mode 100644
index 0000000..df2ab11
--- /dev/null
+++ b/src/common/engineLifecycle.h
@@ -0,0 +1,26 @@
+#ifndef COMMON_ENGINE_LIFECYCLE_H_
+#define COMMON_ENGINE_LIFECYCLE_H_
+
+#include <atomic>
+
+// A cooperative stop shared by the game loop and the host's in-process coordinator. The flag lives once per
+// isolated engine object, so stopping one engine cannot stop the other.
+inline std::atomic<bool> &EngineLifecycle_StopFlag() {
+    static std::atomic<bool> requested{false};
+    return requested;
+}
+
+inline bool EngineLifecycle_StopRequested() {
+    return EngineLifecycle_StopFlag().load(std::memory_order_acquire);
+}
+
+inline void EngineLifecycle_RequestStop() {
+    EngineLifecycle_StopFlag().store(true, std::memory_order_release);
+}
+
+inline void EngineLifecycle_ResetStop() {
+    EngineLifecycle_StopFlag().store(false, std::memory_order_release);
+}
+
+#endif // COMMON_ENGINE_LIFECYCLE_H_
+
